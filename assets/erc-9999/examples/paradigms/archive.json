{
  "aifp": "1",
  "family": "aifp.examples.archive",
  "version": "1.0.0",
  "title": "Archive: published objects read later by pull",
  "labels": [
    "aifp:paradigm/archive/v1"
  ],
  "carriers": [
    "shared-object"
  ],
  "operators": [
    "fan-out"
  ],
  "cardinality": {
    "contributors": "roster",
    "pairwise": false
  },
  "dimensions": {
    "discovery": "public-directory",
    "observation": {
      "readScope": "open",
      "submissionVisibility": "all",
      "payloadProtection": "none",
      "metadataProtection": "none"
    },
    "contribution": {
      "actions": [
        "publish"
      ],
      "acquisition": "manager",
      "transferable": false,
      "expiry": "none"
    },
    "management": {
      "admission": [
        "source"
      ],
      "ordering": [
        "protocol"
      ],
      "removal": [
        "source"
      ],
      "rules": [
        "source"
      ],
      "disclosure": [
        "source"
      ]
    },
    "redistribution": {
      "forward": true,
      "quote": true,
      "derive": true,
      "publishElsewhere": true
    },
    "history": {
      "lateJoiner": "all",
      "retention": "indefinite",
      "mutable": false
    },
    "time": {
      "realtime": false,
      "correlation": "request-response",
      "delivery": [
        "pull"
      ],
      "batching": "none",
      "clock": "registry",
      "absence": "none"
    },
    "disclosureTiming": "immediate",
    "contributorVisibility": "identified",
    "admissionBasis": [
      "open-discovery"
    ],
    "representation": "allowed",
    "objectRelations": [
      "replyTo",
      "forwards",
      "derivesFrom",
      "synthesizes",
      "references",
      "supersedes",
      "retracts"
    ],
    "ordering": {
      "sequencer": "protocol",
      "order": "total",
      "observable": true
    }
  },
  "predicates": {
    "observe": {
      "open": true
    }
  },
  "requiredBindings": {
    "capabilities": [
      "pull",
      "history-retention",
      "late-join-history"
    ]
  }
}
