{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/asf/profile-descriptor.schema.json",
  "title": "ASF Profile Descriptor",
  "description": "A versioned, content-addressed description of one constraint vocabulary: which parameters it takes, how they are interpreted, whether narrowing between two parameter sets is decidable, and how compliance is verified. profileId = keccak256(UTF-8(identifier)); the descriptor hash is keccak256(UTF-8(JCS(document))).",
  "type": "object",
  "required": ["asf", "kind", "identifier", "family", "summary", "parameterSchema", "partialOrder", "verification"],
  "properties": {
    "asf": { "const": "1.0" },
    "kind": { "const": "profile-descriptor" },
    "identifier": { "$ref": "common.schema.json#/$defs/identifier" },
    "family": { "$ref": "common.schema.json#/$defs/family" },
    "summary": { "type": "string", "minLength": 1 },
    "evaluatesOver": {
      "type": "array",
      "items": { "type": "string", "enum": ["action", "state", "trajectory", "group", "relation"] }
    },
    "parameterSchema": { "type": "object", "description": "JSON Schema of the parameters a binding supplies under this profile." },
    "partialOrder": {
      "type": "object",
      "required": ["defined"],
      "properties": {
        "defined": { "type": "boolean", "description": "Whether \"not wider than\" between two parameter sets is decidable for this profile." },
        "rule": { "type": "string", "description": "The decision rule when defined." }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "location"],
        "properties": {
          "method": { "type": "string", "enum": ["rule-engine", "formal-proof", "zero-knowledge-proof", "trusted-execution", "runtime-monitoring", "human-review", "on-chain-guard"] },
          "location": { "$ref": "common.schema.json#/$defs/enforcementLocation" },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "resultMeaning": { "type": "string" },
          "trustAssumptions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
