{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ethereum/ERCs/blob/master/assets/erc-9999/schemas/transition.schema.json",
  "title": "ACCF Transition Record",
  "description": "What changed, on whose authorization, from which state to which, what stays valid and what does not, how obligations continue, and what has to hold afterwards.",
  "type": "object",
  "required": [
    "accf",
    "kind",
    "unit",
    "authorization",
    "reason",
    "source",
    "target",
    "obligations",
    "postConditions"
  ],
  "properties": {
    "accf": {
      "const": "transition/1"
    },
    "kind": {
      "enum": [
        "registration",
        "derivation",
        "migration",
        "succession",
        "repair",
        "upgrade",
        "composition",
        "decomposition",
        "control-change",
        "retirement",
        "suspension",
        "resumption",
        "boundary-change",
        "extension"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "counterpart": {
      "type": "string"
    },
    "authorization": {
      "type": "object",
      "required": [
        "source",
        "rule"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "target": {
      "type": "object",
      "minProperties": 1
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(execution|intelligence|state|capability|maintenance|protocol|economic|control|scheme:(lineage|interaction|maintenance|composition)|extension:[0-9]{2,3}|boundary|relation:control)$"
      }
    },
    "retained": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalidated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "obligations": {
      "type": "string",
      "minLength": 1,
      "description": "Who answers for what was open before the transition."
    },
    "recovery": {
      "type": "object"
    },
    "postConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
