{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ethereum/ERCs/blob/master/assets/erc-9999/schemas/policy.schema.json",
  "title": "ACCF evaluation policy",
  "description": "What a consumer accepts when it reads the derived view: sources, methods, freshness, how assessors may be combined and how contradictions are resolved.",
  "type": "object",
  "required": [
    "accf",
    "profile",
    "assessors",
    "mixing",
    "conflictRule",
    "acceptedStates",
    "liveEvidence"
  ],
  "properties": {
    "accf": {
      "const": "policy/1"
    },
    "profile": {
      "type": "object",
      "required": [
        "commitment"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commitment": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "assessors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "assessor",
          "axes"
        ],
        "properties": {
          "assessor": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "axes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "infrastructure",
                "protocol",
                "economic"
              ]
            }
          }
        }
      }
    },
    "methods": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9a-f]{64}$"
      }
    },
    "maxAge": {
      "type": "integer",
      "minimum": 0
    },
    "mixing": {
      "enum": [
        "single-assessor",
        "per-axis",
        "per-requirement"
      ]
    },
    "conflictRule": {
      "enum": [
        "undetermined",
        "priority",
        "unanimous"
      ]
    },
    "acceptedStates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "active",
          "degraded",
          "suspended",
          "maintenance"
        ]
      }
    },
    "liveEvidence": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    }
  }
}
