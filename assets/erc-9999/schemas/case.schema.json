{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "ADRF case document",
  "description": "The eight elements a dispute must state, hashed into the on-chain claim's documentHash: object, event, claim, rules, subjects, authorization, evidence, effects; plus the typed sub-questions with their premises.",
  "type": "object",
  "required": ["kind", "adrf", "object", "event", "claim", "rules", "subjects", "authorization", "evidence", "effects", "subQuestions"],
  "properties": {
    "kind": { "const": "adrf-case" },
    "adrf": { "const": "0.1" },
    "object": {
      "type": "object",
      "required": ["ref", "description"],
      "properties": { "ref": { "$ref": "common.schema.json#/$defs/objectRef" }, "description": { "type": "string" } },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["eventRef", "description"],
      "properties": { "eventRef": { "$ref": "common.schema.json#/$defs/bytes32" }, "description": { "type": "string" }, "eventAt": { "$ref": "common.schema.json#/$defs/uint" } },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["statement", "proposition", "decisive", "supportsWhen"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "proposition": { "$ref": "common.schema.json#/$defs/bytes32" },
        "decisive": { "$ref": "common.schema.json#/$defs/uint" },
        "supportsWhen": { "type": "string", "enum": ["TRUE", "FALSE"] }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": ["normRef", "clause", "obligationKind", "policyId"],
      "properties": {
        "normRef": { "$ref": "common.schema.json#/$defs/bytes32" },
        "normDescription": { "type": "string" },
        "clause": { "$ref": "common.schema.json#/$defs/bytes32" },
        "clauseText": { "type": "string" },
        "obligationKind": { "$ref": "common.schema.json#/$defs/obligationKind" },
        "policyId": { "$ref": "common.schema.json#/$defs/bytes32" }
      },
      "additionalProperties": false
    },
    "subjects": {
      "type": "object",
      "required": ["claimant", "respondent"],
      "properties": {
        "claimant": { "$ref": "common.schema.json#/$defs/address" },
        "respondent": { "$ref": "common.schema.json#/$defs/address" },
        "roles": { "type": "array", "items": { "type": "object", "required": ["account", "role"], "properties": { "account": { "$ref": "common.schema.json#/$defs/address" }, "role": { "type": "string" }, "identity": { "type": "string" } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["effectClass"],
      "properties": {
        "effectClass": { "type": "string", "enum": ["Advisory", "Binding"] },
        "bindingId": { "$ref": "common.schema.json#/$defs/bytes32" },
        "acceptanceMode": { "$ref": "common.schema.json#/$defs/acceptanceMode" },
        "acceptedBy": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["scope", "provision", "access", "retention"],
      "properties": {
        "scope": { "type": "string" },
        "scopeHash": { "$ref": "common.schema.json#/$defs/bytes32" },
        "provision": { "type": "string" },
        "access": { "type": "string" },
        "verifiers": { "type": "string" },
        "retention": { "type": "string" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": ["requested", "onSustained", "onNotSustained", "fallbackRef", "atMost"],
      "properties": {
        "requested": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/bytes32" } },
        "onSustained": { "oneOf": [{ "$ref": "common.schema.json#/$defs/bytes32" }, { "type": "null" }] },
        "onNotSustained": { "oneOf": [{ "$ref": "common.schema.json#/$defs/bytes32" }, { "type": "null" }] },
        "fallbackRef": { "$ref": "common.schema.json#/$defs/bytes32" },
        "atMost": { "type": "string" }
      },
      "additionalProperties": false
    },
    "subQuestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["index", "proposition", "statement", "qType", "obligationKind", "dependsOn"],
        "properties": {
          "index": { "$ref": "common.schema.json#/$defs/uint" },
          "proposition": { "$ref": "common.schema.json#/$defs/bytes32" },
          "statement": { "type": "string" },
          "qType": { "$ref": "common.schema.json#/$defs/questionType" },
          "obligationKind": { "type": "integer", "minimum": 0, "maximum": 255 },
          "inputs": { "type": "string" },
          "inputsHash": { "$ref": "common.schema.json#/$defs/bytes32" },
          "dependsOn": { "type": "array", "items": { "type": "object", "required": ["index", "requiredValue"], "properties": { "index": { "$ref": "common.schema.json#/$defs/uint" }, "requiredValue": { "type": "string", "enum": ["TRUE", "FALSE"] } }, "additionalProperties": false } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
