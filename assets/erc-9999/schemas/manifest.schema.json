{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ethereum/ERCs/blob/master/assets/erc-9999/schemas/manifest.schema.json",
  "title": "ACCF Cell Manifest",
  "description": "The configuration, state materials, dependencies and authorizations needed to deploy, restore, maintain and derive the unit, in separately committed entries. The metadata member is not committed. A manifest carries no secret.",
  "type": "object",
  "required": [
    "accf",
    "entries"
  ],
  "properties": {
    "accf": {
      "const": "manifest/1"
    },
    "entries": {
      "type": "object",
      "properties": {
        "execution": {
          "type": "object",
          "minProperties": 1
        },
        "intelligence": {
          "type": "object",
          "minProperties": 1
        },
        "state": {
          "type": "object",
          "minProperties": 1
        },
        "capability": {
          "type": "object",
          "minProperties": 1
        },
        "maintenance": {
          "type": "object",
          "minProperties": 1
        },
        "protocol": {
          "type": "object",
          "minProperties": 1
        },
        "economic": {
          "type": "object",
          "minProperties": 1
        },
        "control": {
          "type": "object",
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "schemes": {
      "type": "object",
      "properties": {
        "lineage": {
          "type": "object",
          "required": [
            "capability",
            "authorization",
            "resources",
            "postChecks",
            "feasibility"
          ],
          "properties": {
            "capability": {
              "type": "string",
              "minLength": 1
            },
            "preconditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "authorization": {
              "type": "object",
              "required": [
                "source"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "resources": {
              "type": "object",
              "minProperties": 1
            },
            "mechanism": {
              "type": [
                "string",
                "object"
              ]
            },
            "target": {
              "type": "string"
            },
            "postChecks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "feasibility": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "commitment"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "commitment": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "description": "One scheme ties the infrastructure, protocol and economic part of a lifecycle capability together: preconditions, authorization and resource conditions, mechanism, target state, checks afterwards, and evidence that it works end to end."
        },
