{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auf:v1:observation.schema.json",
  "title": "AUF observation content (auf:observation:v1@1)",
  "description": "Per-asset stocks, port transfers, minting, burning, adjustments, non-cash changes and coverage over a window (ERC Section 8). Missing members are listed under `missing`, never reported as zero.",
  "type": "object",
  "required": ["auf", "kind", "subject", "window", "snapshotAt", "assets", "coverage"],
  "properties": {
    "auf": { "$ref": "urn:auf:v1:common.schema.json#/$defs/aufVersion" },
    "kind": { "const": "observation" },
    "subject": { "$ref": "urn:auf:v1:common.schema.json#/$defs/subject" },
    "window": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "urn:auf:v1:common.schema.json#/$defs/timestamp" },
        "to": { "$ref": "urn:auf:v1:common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "snapshotAt": { "$ref": "urn:auf:v1:common.schema.json#/$defs/timestamp" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/assetEntry" } },
    "internal": { "type": "array", "items": { "$ref": "#/$defs/transfer" } },
    "nonCash": { "type": "array", "items": { "$ref": "#/$defs/nonCashEntry" } },
    "coverage": {
      "type": "object",
      "required": ["observed", "missing"],
      "properties": {
        "observed": { "type": "array", "items": { "type": "string" } },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item"],
            "properties": { "item": { "type": "string" }, "reason": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "method": { "type": "string" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "method": { "type": "string" },
    "source": { "type": "string" },
    "evidence": { "$ref": "urn:auf:v1:common.schema.json#/$defs/evidence" },
    "extensions": { "$ref": "urn:auf:v1:common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false,
  "$defs": {
    "amount": { "$ref": "urn:auf:v1:common.schema.json#/$defs/unsignedDecimalString" },
    "transfer": {
      "type": "object",
      "required": ["amount"],
      "properties": {
        "port": { "type": "string" },
        "direction": { "enum": ["in", "out"] },
        "asset": { "type": "string" },
        "amount": { "$ref": "#/$defs/amount" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "counterparty": { "type": "string" },
        "at": { "$ref": "urn:auf:v1:common.schema.json#/$defs/timestamp" },
        "evidence": { "$ref": "urn:auf:v1:common.schema.json#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "assetEntry": {
      "type": "object",
      "required": ["asset"],
      "properties": {
        "asset": { "type": "string", "minLength": 1 },
        "opening": { "$ref": "#/$defs/amount" },
        "closing": { "$ref": "#/$defs/amount" },
        "inflow": { "$ref": "#/$defs/amount" },
        "outflow": { "$ref": "#/$defs/amount" },
        "minted": { "$ref": "#/$defs/amount" },
        "burned": { "$ref": "#/$defs/amount" },
        "adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["amount", "reason"],
            "properties": {
              "amount": { "$ref": "urn:auf:v1:common.schema.json#/$defs/decimalString" },
              "reason": { "type": "string" },
              "evidence": { "$ref": "urn:auf:v1:common.schema.json#/$defs/evidence" }
            },
            "additionalProperties": false
          }
        },
        "transfers": { "type": "array", "items": { "$ref": "#/$defs/transfer" } },
        "missing": {
          "type": "array",
          "items": { "enum": ["opening", "closing", "inflow", "outflow", "minted", "burned", "adjustments", "transfers"] }
        }
      },
      "additionalProperties": false
    },
    "nonCashEntry": {
      "type": "object",
      "required": ["subject", "kind"],
      "properties": {
        "subject": { "type": "string" },
        "kind": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "basis": { "$ref": "urn:auf:v1:common.schema.json#/$defs/evidence" }
      },
      "additionalProperties": false
    }
  }
}
