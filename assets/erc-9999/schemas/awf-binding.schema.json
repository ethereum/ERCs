{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awf-binding.schema.json",
  "title": "Agent Whitelist Framework: binding document",
  "description": "What an adopter declares when it puts lists to use. Its keccak256 over the RFC 8785 form is BindingConfig.documentHash",
  "type": "object",
  "required": ["awf", "kind", "name", "adoption", "scopeDocument", "role", "actions", "lists", "rules", "updates", "workInProgress"],
  "additionalProperties": false,
  "properties": {
    "awf": { "const": "1" },
    "kind": { "const": "binding" },
    "name": { "type": "string" },
    "adoption": {
      "description": "Who adopts and on what authority over the consumer",
      "type": "object",
      "required": ["consumer", "authority"],
      "additionalProperties": false,
      "properties": {
        "consumer": { "type": "string" },
        "authority": { "type": "string" }
      }
    },
    "scopeDocument": { "description": "documentHash of the scope the binding applies in", "$ref": "awf-defs.schema.json#/$defs/bytes32" },
    "role": { "enum": ["ACTOR", "OBJECT"] },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "once", "effect"],
        "additionalProperties": false,
        "properties": {
          "action": { "$ref": "awf-defs.schema.json#/$defs/name" },
          "once": { "type": "boolean" },
          "effect": { "description": "What proceeding and what refusing mean for this action", "type": "string" }
        }
      }
    },
    "lists": {
      "type": "object",
      "required": ["allow", "allowThreshold", "deny", "denyThreshold"],
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "$ref": "#/$defs/listUse" } },
        "allowThreshold": { "type": "integer", "minimum": 0 },
        "deny": { "type": "array", "items": { "$ref": "#/$defs/listUse" } },
        "denyThreshold": { "type": "integer", "minimum": 0 }
      }
    },
    "rules": {
      "type": "object",
      "required": ["onConflict", "onNoMatch", "onIndeterminate", "onNotApplicable"],
      "additionalProperties": false,
      "properties": {
        "onConflict": { "enum": ["ALLOW", "DENY", "INDETERMINATE"] },
        "onNoMatch": { "enum": ["ALLOW", "DENY", "NOT_APPLICABLE"] },
        "onIndeterminate": { "$ref": "awf-defs.schema.json#/$defs/disposition" },
        "onNotApplicable": { "$ref": "awf-defs.schema.json#/$defs/disposition" },
        "restriction": { "description": "What PROCEED_RESTRICTED limits, where it is used", "type": "string" }
      }
    },
    "standing": { "description": "ACTOR: how it is established that a caller may act for a subject", "type": "string" },
    "updates": { "description": "How the binding follows changes of its lists and who may amend it", "type": "string" },
    "workInProgress": { "description": "What a change of result means for work already admitted, action by action", "type": "string" }
  },
  "$defs": {
    "listUse": {
      "type": "object",
      "required": ["list", "follows"],
      "additionalProperties": false,
      "properties": {
        "list": { "type": "string" },
        "follows": { "description": "latest: every change of the list applies at once. pinned: the binding holds to one state until it is amended", "enum": ["latest", "pinned"] },
        "why": { "type": "string" }
      }
    }
  }
}
