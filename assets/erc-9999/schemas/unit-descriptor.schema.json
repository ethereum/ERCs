{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ethereum/ERCs/blob/master/assets/erc-9999/schemas/unit-descriptor.schema.json",
  "title": "ACCF Unit Descriptor",
  "description": "Who the assessed unit is, what it answers for and how it is controlled. The Cell Record commits to this document.",
  "type": "object",
  "required": [
    "accf",
    "subject",
    "kind",
    "duties",
    "boundary",
    "control"
  ],
  "properties": {
    "accf": {
      "const": "unit-descriptor/1"
    },
    "subject": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string"
        }
      }
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "description": "Open label: agent, embodied, service, composite or another kind."
    },
    "duties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "What the unit commits to do. Requirements are read against these duties."
    },
    "environment": {
      "type": "string"
    },
    "boundary": {
      "type": "object",
      "required": [
        "accounts",
        "resources",
        "obligations"
      ],
      "properties": {
        "accounts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a composite unit: its members."
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "mechanism",
        "intervention"
      ],
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1,
          "description": "Single account, several parties, a contract or another declared mechanism."
        },
        "controller": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "intervention": {
          "type": "object",
          "required": [
            "restrict",
            "resume",
            "exit"
          ],
          "properties": {
            "restrict": {
              "type": "string",
              "minLength": 1
            },
            "resume": {
              "type": "string",
              "minLength": 1
            },
            "exit": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "Who can restrict which operations, how the unit stops taking new obligations, and how it resumes or exits."
        }
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "disclosure": {
          "enum": [
            "public",
            "commitment",
            "controlled",
            "proof"
          ]
        }
      }
    }
  }
}
