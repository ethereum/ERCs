{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/asf/intervention-response.schema.json",
  "title": "ASF Intervention Response document",
  "description": "What a suspension means operationally. Its canonical hash is the responseRef recorded with the suspension. The on-chain restrictions bit set is the union of the listed response requirements.",
  "type": "object",
  "required": [
    "asf",
    "kind",
    "initiator",
    "restrictions",
    "scope",
    "prohibited",
    "allowed",
    "mustContinue",
    "inFlight",
    "duration",
    "resume"
  ],
  "properties": {
    "asf": {
      "const": "1.0"
    },
    "kind": {
      "const": "intervention-response"
    },
    "binding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/bytes32"
        },
        "example": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "initiator": {
      "type": "object",
      "required": [
        "ref",
        "role",
        "basis"
      ],
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/accountRef"
        },
        "role": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "description": "The right under which the initiator acts: adopter, or an intervener right granted in the binding."
        }
      },
      "additionalProperties": false
    },
    "restrictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/restriction"
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "resources",
        "paths"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "prohibited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mustContinue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inFlight": {
      "type": "string",
      "description": "How actions already authorized or sent before the suspension are handled."
    },
    "duration": {
      "type": "object",
      "properties": {
        "until": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "condition": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "required": [
        "who"
      ],
      "properties": {
        "who": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ref"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
