{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/asf/requirement-set.schema.json",
  "title": "ASF Requirement Set document",
  "description": "What a resource requires before it admits a subject: which bindings, under which combinator. Role-relative values (\"self\") are resolved by the consumer when it builds the on-chain RequirementSet struct; requirementId is the keccak256 of the ABI encoding of that struct.",
  "type": "object",
  "required": ["asf", "kind", "combinator", "clauses"],
  "properties": {
    "asf": { "const": "1.0" },
    "kind": { "const": "requirement-set" },
    "name": { "type": "string" },
    "combinator": { "type": "string", "enum": ["all", "any", "k-of"] },
    "k": { "type": "integer", "minimum": 1 },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "specification"],
        "properties": {
          "role": { "type": "string", "minLength": 1, "description": "Which participant this clause is about (fulfiller, operator, principal, member ...)." },
          "specification": {
            "type": "object",
            "required": ["registry", "specId"],
            "properties": {
              "registry": { "$ref": "common.schema.json#/$defs/accountRef" },
              "specId": { "$ref": "common.schema.json#/$defs/bytes32" },
              "name": { "type": "string" }
            },
            "additionalProperties": false
          },
          "versions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "Explicit allowed versions; empty or absent admits every version. Ranges are not expressible on purpose." },
          "adopter": {
            "description": "\"self\" (the role's own account), \"any\", or an account reference",
            "anyOf": [{ "type": "string", "enum": ["self", "any"] }, { "$ref": "common.schema.json#/$defs/accountRef" }]
          },
          "subject": {
            "description": "\"self\", \"any\", or a subject reference",
            "anyOf": [{ "type": "string", "enum": ["self", "any"] }, { "$ref": "common.schema.json#/$defs/ref" }]
          },
          "scope": {
            "description": "\"any\" or a scope object",
            "oneOf": [{ "const": "any" }, { "type": "object", "minProperties": 1 }]
          },
          "enforcement": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/enforcementLocation" }, "description": "Locations that MUST all be declared by the binding." }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "combinator": { "const": "k-of" } } },
      "then": { "required": ["k"] },
      "else": { "not": { "required": ["k"] } }
    }
  ],
  "additionalProperties": false
}
