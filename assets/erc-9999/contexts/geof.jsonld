    "recordedAt": { "@id": "geof:recordedAt", "@type": "xsd:integer" },
    "reportedAt": "geof:reportedAt",
    "event": "geof:event",
    "aggregate": "geof:aggregate",
    "followup": "geof:followup",
    "intervention": "geof:intervention",
    "origin": "geof:origin",
