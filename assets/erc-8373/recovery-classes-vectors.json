{
  "description": "pq-recovery-classes.v0 \u2014 rotation/kill/seed-rotation as recomputable falsifiable claims (mode=classify), plus the standing binding-path constraint (mode=bind_gate): an unlifted agent_terminal forbids future bindings. terminal_owner=absolute; terminal_incident liftable ONLY by a valid fleet seed_epoch_rotation (never a per-agent path). derive() is the pinned key-derivation shape, not the live master seed.",
  "cases": [
    {
      "case_id": "rotation_valid_continuity",
      "mode": "classify",
      "expected_verdict": "continuity",
      "statement": {
        "class": "rotation",
        "owner": "0xabc0000000000000000000000000000000000abc",
        "auth": {
          "path": "siwe_owner",
          "identity": "0xabc0000000000000000000000000000000000abc"
        },
        "anchor_time": 1700,
        "revokes_content_address": "cc_e0",
        "superseded_by_content_address": "cc_e1"
      },
      "history_after": [
        {
          "content_address": "cc_e0",
          "binding_anchor_time": 1600,
          "revoked_at": 1700
        },
        {
          "content_address": "cc_e1",
          "binding_anchor_time": 1700,
          "revoked_at": null
        }
      ]
    },
