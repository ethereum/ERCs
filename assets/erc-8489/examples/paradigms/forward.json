{
  "aifp": "1",
  "family": "aifp.examples.forward",
  "version": "1.0.0",
  "title": "Forward: the same object enters another context with its provenance",
  "labels": [
    "aifp:paradigm/forward/v1"
  ],
  "carriers": [
    "delivery"
  ],
