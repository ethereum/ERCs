{
  "$schema": "./erc7730-v3.0.0-next.schema.json",
  "$comment": "This is an example of a complete ERC-7730 file using a map keyed on the called contract address, rather than on the chain id. The map keys are ERC-55 checksummed, while the address resolved from @.to carries no casing guarantee, so this example relies on map keys being matched case-insensitively.",
  "context": {
    "$id": "Example Maps for Deployments",
    "contract": {
      "deployments": [
        {
          "chainId": 1,
          "address": "0x00112233445566778899AABBCCDDEEFF00112233"
        },
        {
          "chainId": 1,
          "address": "0xAABBCCDDEEFF00112233445566778899AABBCCDD"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Example",
    "info": {
      "url": "https://example.io/"
    },
    "maps": {
      "underlyingToken": {
        "$keyType": "Address of the called wrapper contract",
        "values": {
          "0x00112233445566778899AABBCCDDEEFF00112233": "0x0000000000000000000000000000000000deadbeef",
          "0xAABBCCDDEEFF00112233445566778899AABBCCDD": "0x0000000000000000000000000000000000feedface"
        }
      }
    }
  },
  "display": {
    "formats": {
      "wrap(address to,uint256 amount)": {
        "intent": "Wrap",
        "interpolatedIntent": "Wrap {amount} to {to}",
        "fields": [
          {
            "path": "amount",
            "label": "Amount",
            "format": "tokenAmount",
            "params": {
              "token": {
                "map": "$.metadata.maps.underlyingToken",
                "keyPath": "@.to"
              }
            }
          },
          {
            "path": "to",
            "label": "Recipient",
            "format": "addressName",
            "params": {
              "types": ["eoa", "contract"]
            }
          }
        ]
      }
    }
  }
}
