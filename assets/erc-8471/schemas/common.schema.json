{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "ADRF common definitions",
  "$defs": {
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "uint": { "type": "integer", "minimum": 0 },
    "objectRef": {
      "type": "object",
      "required": ["chainId", "target", "id", "versionHash"],
      "properties": {
        "chainId": { "$ref": "#/$defs/uint" },
        "target": { "$ref": "#/$defs/address" },
        "id": { "$ref": "#/$defs/uint" },
        "versionHash": { "$ref": "#/$defs/bytes32" }
      },
      "additionalProperties": false
    },
    "questionType": { "type": "string", "enum": ["FORMAL", "EVIDENCED", "JUDGED"] },
    "value": { "type": "string", "enum": ["UNDETERMINED", "TRUE", "FALSE"] },
    "supportKind": { "type": "string", "enum": ["signed", "computed", "evidenced", "judged"] },
    "effectCategory": { "type": "string", "enum": ["SUBSTANTIVE", "PROCEDURAL_ECONOMIC"] },
    "onUndetermined": { "type": "string", "enum": ["NOT_SUSTAINED", "NO_DECISION"] },
    "standingMode": { "type": "string", "enum": ["PARTIES", "BENEFICIARIES", "OPEN"] },
    "acceptanceMode": { "type": "string", "enum": ["PRE_COMMIT", "POST_DISPUTE"] },
    "reviewMode": { "type": "string", "enum": ["PRESERVE_UNLESS_OVERTURNED", "REQUIRE_FRESH_DECISION"] },
    "reviewType": { "type": "string", "enum": ["fact", "evidence", "rule-application", "conflict", "procedure"] },
    "silenceRule": { "type": "string", "enum": ["NONE", "SUSTAIN", "NOT_SUSTAIN"] },
    "procedureState": { "type": "string", "enum": ["Filed", "Admitted", "Provisional", "Final", "NotAdmitted", "Withdrawn", "Expired"] },
    "substantiveResult": { "type": "string", "enum": ["None", "Sustained", "NotSustained", "NoDecision"] },
    "reason": { "type": "string", "enum": ["NONE", "MISSING_ELEMENT", "NO_BINDING_AUTHORITY", "CLOCK_INCOMPATIBLE", "DUPLICATE", "PREMISE_NOT_ESTABLISHED", "METHOD_UNDETERMINED", "BURDEN_NOT_MET", "TIMEOUT", "REVIEW_LAPSED", "ACCEPTANCE_LAPSED", "SILENCE", "PROCEDURE_FAILURE"] },
    "enactmentStatus": { "type": "string", "enum": ["NotRequested", "Pending", "Enacted", "Failed", "Unknown"] },
    "obligationKind": {
      "type": "object",
      "required": ["code", "label"],
      "properties": {
        "code": { "type": "integer", "minimum": 1, "maximum": 255 },
        "label": { "type": "string", "enum": ["result", "process", "limit", "statistical-quality", "other"] },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "judgmentSource": {
      "type": "object",
      "required": ["registry", "issueId", "policyId", "sourceRound", "roundCount", "adoptedFromEarlierRound"],
      "properties": {
        "registry": { "$ref": "#/$defs/address" },
        "issueId": { "$ref": "#/$defs/bytes32" },
        "policyId": { "$ref": "#/$defs/bytes32" },
        "sourceRound": { "$ref": "#/$defs/uint" },
        "roundCount": { "$ref": "#/$defs/uint" },
        "adoptedFromEarlierRound": { "type": "boolean" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
