{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruling.schema.json",
  "title": "ADRF ruling receipt",
  "description": "An off-chain mirror of a Final or Expired case's ruling. The registry record is authoritative; a receipt is data for readers and never a substitute for reading the registry.",
  "type": "object",
  "required": ["kind", "adrf", "registry", "caseId", "state", "result", "effectClass", "reason", "closure", "roundCount", "sourceRound", "adoptedFromEarlierRound", "bySilence", "supportKinds", "allowedEffect", "fallbackRef", "policyId", "proposition"],
  "properties": {
    "kind": { "const": "adrf-ruling" },
    "adrf": { "const": "0.1" },
    "registry": { "$ref": "common.schema.json#/$defs/address" },
    "chainId": { "$ref": "common.schema.json#/$defs/uint" },
    "caseId": { "$ref": "common.schema.json#/$defs/bytes32" },
    "state": { "type": "string", "enum": ["Final", "Expired"] },
    "result": { "$ref": "common.schema.json#/$defs/substantiveResult" },
    "effectClass": { "type": "string", "enum": ["Advisory", "Binding"] },
    "reason": { "$ref": "common.schema.json#/$defs/reason" },
    "closure": { "type": "string", "enum": ["NONE", "REVIEW_LAPSED", "TIMEOUT"] },
    "decidedAt": { "$ref": "common.schema.json#/$defs/uint" },
    "finalAt": { "$ref": "common.schema.json#/$defs/uint" },
    "roundCount": { "$ref": "common.schema.json#/$defs/uint" },
    "sourceRound": { "$ref": "common.schema.json#/$defs/uint" },
    "adoptedFromEarlierRound": { "type": "boolean" },
    "bySilence": { "type": "boolean" },
    "supportKinds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/supportKind" } },
    "allowedEffect": { "oneOf": [{ "$ref": "common.schema.json#/$defs/bytes32" }, { "type": "null" }] },
    "fallbackRef": { "oneOf": [{ "$ref": "common.schema.json#/$defs/bytes32" }, { "type": "null" }] },
    "policyId": { "$ref": "common.schema.json#/$defs/bytes32" },
    "bindingId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/bytes32" }, { "type": "null" }] },
    "source": { "oneOf": [{ "$ref": "common.schema.json#/$defs/address" }, { "type": "null" }] },
    "proposition": { "$ref": "common.schema.json#/$defs/bytes32" },
    "judgment": { "$ref": "common.schema.json#/$defs/judgmentSource" },
    "basis": { "type": "string", "description": "Which findings the result cites and what each supports; never a claim beyond those findings." }
  },
  "additionalProperties": false
}
