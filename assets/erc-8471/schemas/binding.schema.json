{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "binding.schema.json",
  "title": "ADRF Dispute Binding document",
  "description": "The source's published statement that accompanies a binding: what it accepts, what it commits, who may enact, who else has standing, and the clock rules; bound to the on-chain binding through termsHash.",
  "type": "object",
  "required": [
    "kind",
    "adrf",
    "source",
    "policyId",
    "scope",
    "mode",
    "authorizedEffects",
    "executors",
    "clockRules",
    "recognizedBreaches"
  ],
  "properties": {
    "kind": {
      "const": "adrf-binding"
    },
    "adrf": {
      "const": "0.1"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/address"
    },
    "sourceDescription": {
      "type": "string"
    },
    "policyId": {
      "$ref": "common.schema.json#/$defs/bytes32"
    },
    "scope": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "any-object-of-source",
            "object"
          ]
        },
        "object": {
          "$ref": "common.schema.json#/$defs/objectRef"
        },
        "scopeKey": {
          "$ref": "common.schema.json#/$defs/bytes32"
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "$ref": "common.schema.json#/$defs/acceptanceMode"
    },
    "authorizedEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/bytes32"
          },
          "label": {
            "type": "string"
          },
          "authorityBasis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "executors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account",
          "role"
        ],
        "properties": {
          "account": {
            "$ref": "common.schema.json#/$defs/address"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "account",
          "basis"
        ],
        "properties": {
          "account": {
            "$ref": "common.schema.json#/$defs/address"
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "openChallenge": {
      "type": "boolean"
    },
    "openChallengeTerms": {
      "type": "string"
    },
    "downgradeOnClock": {
      "type": "boolean"
    },
    "validUntil": {
      "$ref": "common.schema.json#/$defs/uint"
    },
    "fundAuthorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instrument",
          "limit"
        ],
        "properties": {
          "instrument": {
            "type": "string"
          },
          "limit": {
            "type": "string"
          },
          "executor": {
            "$ref": "common.schema.json#/$defs/address"
          }
        },
        "additionalProperties": false
      }
    },
    "clockRules": {
      "type": "object",
      "required": [
        "clock",
        "triggerEvents",
        "adoptionDeadlineRule"
      ],
      "properties": {
        "clock": {
          "type": "string"
        },
        "triggerEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "eventRef",
              "label"
            ],
            "properties": {
              "eventRef": {
                "$ref": "common.schema.json#/$defs/bytes32"
              },
              "label": {
                "type": "string"
              },
              "obligationKind": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "adoptionDeadlineRule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "recognizedBreaches": {
      "type": "array",
      "description": "The breach predicates the source recognizes under its norm, per event: a Binding claim is admitted only if its decisive sub-question, in the claim's direction, is one of them (recognizesBreach of IADRFObligationSource).",
      "items": {
        "type": "object",
        "required": [
          "event",
          "obligationKind",
          "proposition",
          "breachWhen"
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "obligationKind": {
            "type": "integer"
          },
          "proposition": {
            "type": "string",
            "description": "the proposition (its canonical statement or the rule that derives it)"
          },
          "breachWhen": {
            "type": "string",
            "enum": [
              "TRUE",
              "FALSE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "noDecisionDisposition": {
      "type": "object",
      "required": [
        "ref",
        "description"
      ],
      "properties": {
        "ref": {
          "$ref": "common.schema.json#/$defs/bytes32"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "identitiesNote": {
      "type": "string",
      "description": "whether any identity, qualification or organizational scheme is required of the parties (none by default)"
    }
  },
  "additionalProperties": false
}
