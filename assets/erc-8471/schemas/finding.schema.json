{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "ADRF finding record",
  "description": "What was decided, by which method and version, on which inputs, on which premises, with which unverified external premises, accepted by whom, with which support kinds. Support kinds are a set; no ordering is defined.",
  "type": "object",
  "required": ["kind", "adrf", "caseId", "subQuestion", "proposition", "value", "method", "supportKinds", "reason"],
  "properties": {
    "kind": { "const": "adrf-finding" },
    "adrf": { "const": "0.1" },
    "caseId": { "$ref": "common.schema.json#/$defs/bytes32" },
    "subQuestion": { "$ref": "common.schema.json#/$defs/uint" },
    "round": { "$ref": "common.schema.json#/$defs/uint" },
    "proposition": { "$ref": "common.schema.json#/$defs/bytes32" },
    "statement": { "type": "string" },
    "value": { "$ref": "common.schema.json#/$defs/value" },
    "method": { "type": "object", "required": ["address", "qType"], "properties": { "address": { "$ref": "common.schema.json#/$defs/address" }, "qType": { "$ref": "common.schema.json#/$defs/questionType" }, "version": { "type": "string" }, "codeHash": { "$ref": "common.schema.json#/$defs/bytes32" }, "params": { "$ref": "common.schema.json#/$defs/bytes32" } }, "additionalProperties": false },
    "inputs": { "type": "object", "properties": { "description": { "type": "string" }, "inputsHash": { "$ref": "common.schema.json#/$defs/bytes32" }, "resultHash": { "$ref": "common.schema.json#/$defs/bytes32" } }, "additionalProperties": false },
    "dependsOn": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/uint" } },
    "externalPremises": { "type": "array", "items": { "type": "string" } },
    "acceptedBy": { "$ref": "common.schema.json#/$defs/address" },
    "supportKinds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/supportKind" } },
    "reason": { "$ref": "common.schema.json#/$defs/reason" },
    "source": { "$ref": "common.schema.json#/$defs/judgmentSource" },
    "at": { "$ref": "common.schema.json#/$defs/uint" }
  },
  "additionalProperties": false
}
