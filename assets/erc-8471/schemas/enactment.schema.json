{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "enactment.schema.json",
  "title": "ADRF enactment report",
  "description": "What an executor did with one effect of a ruling: the status it reported, the clause the effect follows from, and the three amounts (adjudged, enforceable now, enacted) that need not coincide.",
  "type": "object",
  "required": ["kind", "adrf", "caseId", "effectId", "executor", "status"],
  "properties": {
    "kind": { "const": "adrf-enactment" },
    "adrf": { "const": "0.1" },
    "caseId": { "$ref": "common.schema.json#/$defs/bytes32" },
    "effectId": { "$ref": "common.schema.json#/$defs/bytes32" },
    "effectLabel": { "type": "string" },
    "category": { "$ref": "common.schema.json#/$defs/effectCategory" },
    "executor": { "$ref": "common.schema.json#/$defs/address" },
    "status": { "$ref": "common.schema.json#/$defs/enactmentStatus" },
    "ref": { "$ref": "common.schema.json#/$defs/bytes32" },
    "clause": { "type": "string", "description": "The term of the policy, binding or business contract the effect follows from." },
    "nature": { "type": "string", "enum": ["substantive-remedy", "allocation-condition", "proven-violation"] },
    "amounts": { "type": "object", "properties": { "adjudged": { "type": "string" }, "enforceable": { "type": "string" }, "enacted": { "type": "string" } }, "additionalProperties": false },
    "changesSubstantiveResult": { "const": false },
    "at": { "$ref": "common.schema.json#/$defs/uint" }
  },
  "additionalProperties": false
}
