{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/asf/safety-binding.schema.json",
  "title": "ASF Safety Binding parameters document",
  "description": "The off-chain parameters of a Safety Binding. Its canonical hash is the binding's paramsHash. The on-chain record (adopter, subjectKey, scopeKey, specification pin, validity, parent, interveners, enforcement bit set) is authoritative wherever the two overlap.",
  "type": "object",
  "required": ["asf", "kind", "adopter", "subject", "scope", "specification", "parameters", "authorityBasis", "mechanisms"],
  "properties": {
    "asf": { "const": "1.0" },
    "kind": { "const": "safety-binding" },
    "adopter": {
      "type": "object",
      "required": ["ref"],
      "properties": { "ref": { "$ref": "common.schema.json#/$defs/accountRef" }, "role": { "type": "string" } },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": { "$ref": "common.schema.json#/$defs/ref" },
        "key": { "$ref": "common.schema.json#/$defs/bytes32", "description": "keccak256(UTF-8(ref))" },
        "kind": { "type": "string" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["object"],
      "properties": {
        "object": {
          "type": "object",
          "minProperties": 1,
          "description": "The scope object; scopeKey = keccak256(UTF-8(JCS(object))). A one-member object {\"ref\": ...} is the form derivable on chain."
        },
        "key": { "$ref": "common.schema.json#/$defs/bytes32" }
      },
      "additionalProperties": false
    },
    "specification": {
      "type": "object",
      "required": ["registry", "specId", "version"],
      "properties": {
        "registry": { "$ref": "common.schema.json#/$defs/accountRef" },
        "specId": { "$ref": "common.schema.json#/$defs/bytes32" },
        "version": { "type": "integer", "minimum": 1 },
        "contentHash": { "$ref": "common.schema.json#/$defs/bytes32" },
        "locator": { "type": "string" },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "description": "Instantiation of the specification's constraints, keyed by profile identifier.",
      "propertyNames": { "$ref": "common.schema.json#/$defs/identifier" },
      "additionalProperties": { "type": "object" }
    },
    "authorityBasis": {
      "type": "array",
      "minItems": 1,
      "description": "External permission records that entitle the adopter to adopt for this subject and scope. authorityRef = keccak256(UTF-8(JCS(authorityBasis))).",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "description": "Where the adopted arrangement is actually enforced for this binding. The on-chain enforcement bit set is the union of the locations listed here.",
      "items": {
        "type": "object",
        "required": ["channel", "location"],
        "properties": {
          "channel": { "type": "string" },
          "mechanism": { "$ref": "common.schema.json#/$defs/mechanism" },
          "location": { "$ref": "common.schema.json#/$defs/enforcementLocation" },
          "coverage": { "type": "string", "enum": ["full", "partial"] }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ref"],
        "properties": {
          "id": { "type": "string" },
          "ref": { "type": "string" },
          "kind": { "type": "string" },
          "validity": { "$ref": "common.schema.json#/$defs/validity" }
        },
        "additionalProperties": false
      }
    },
    "derived": {
      "type": "object",
      "required": ["parentBindingId"],
      "properties": {
        "parentBindingId": { "$ref": "common.schema.json#/$defs/bytes32" },
        "narrowing": {
          "type": "object",
          "description": "Per profile: how this binding's parameters are not wider than the parent's, with the basis used.",
          "propertyNames": { "$ref": "common.schema.json#/$defs/identifier" },
          "additionalProperties": {
            "type": "object",
            "required": ["relation"],
            "properties": {
              "relation": { "type": "string", "enum": ["equal", "narrower"] },
              "basis": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "validity": { "$ref": "common.schema.json#/$defs/validity" },
    "interveners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "rights"],
        "properties": {
          "ref": { "$ref": "common.schema.json#/$defs/accountRef" },
          "rights": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["suspend", "resume", "terminate"] } },
          "role": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
