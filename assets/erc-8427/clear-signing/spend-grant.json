{
  "$schema": "https://eips.ethereum.org/assets/eip-7730/erc7730-v2.schema.json",
  "context": {
    "$id": "Portable Spend Grants",
    "contract": {
      "deployments": []
    }
  },
  "metadata": {
    "owner": "Portable Spend Grants reference registry",
    "contractName": "SpendGrantRegistry",
    "info": {
      "url": "https://github.com/tankcdr/ERCs/blob/erc-draft-spend-grants/ERCS/erc-8427.md"
    },
    "constants": {
      "native": "0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE"
    },
    "enums": {
      "recipientMode": {
        "0": "One recipient",
        "1": "Any recipient"
      }
    }
  },
  "display": {
    "definitions": {
      "cap": {
        "format": "tokenAmount",
        "params": {
          "tokenPath": "asset",
          "nativeCurrencyAddress": "$.metadata.constants.native"
        }
      }
    },
    "formats": {
      "register((address principal,address delegate,uint8 recipientMode,address recipient,uint8 assetCombine,uint64 windowSeconds,(address asset,uint256 maxPerCall,uint256 maxPerWindow,uint256 maxTotal)[] assets,uint64 validAfter,uint64 validUntil,uint256 salt) terms)": {
        "$id": "register",
        "intent": "Grant spending",
        "fields": [
          {
            "path": "terms.delegate",
            "label": "Delegate",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            }
          },
          {
            "path": "terms.recipientMode",
            "label": "Pays to",
            "format": "enum",
            "params": {
              "$ref": "$.metadata.enums.recipientMode"
            }
          },
          {
            "path": "terms.recipient",
            "label": "Recipient",
            "format": "addressName",
            "visible": {
              "ifNotIn": [
                "0x0000000000000000000000000000000000000000"
              ]
            }
          },
          {
            "path": "terms.windowSeconds",
            "label": "Rolling window",
            "format": "duration"
          },
          {
            "path": "terms.assets.[]",
            "fields": [
              {
                "path": "maxPerCall",
                "label": "Max per payment",
                "$ref": "$.display.definitions.cap"
              },
              {
                "path": "maxPerWindow",
                "label": "Max in any rolling window",
                "$ref": "$.display.definitions.cap"
              },
              {
                "path": "maxTotal",
                "label": "Max in total",
                "$ref": "$.display.definitions.cap"
              },
              {
                "$id": "Shown as each cap's token",
                "path": "asset",
                "visible": "never"
              }
            ]
          },
          {
            "path": "terms.validAfter",
            "label": "Valid from",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          },
          {
            "path": "terms.validUntil",
            "label": "Valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          },
          {
            "$id": "Must be the sender; register and update revert otherwise",
            "path": "terms.principal",
            "visible": "never"
          },
          {
            "$id": "Only 0 (independent per-asset caps) is valid",
            "path": "terms.assetCombine",
            "visible": {
              "mustMatch": [
                0
              ]
            }
          },
          {
            "$id": "Distinguishes otherwise identical grants; update ignores it",
            "path": "terms.salt",
            "visible": "never"
          }
        ]
      },
      "update(bytes32 grantId,uint256 expectedVersion,(address principal,address delegate,uint8 recipientMode,address recipient,uint8 assetCombine,uint64 windowSeconds,(address asset,uint256 maxPerCall,uint256 maxPerWindow,uint256 maxTotal)[] assets,uint64 validAfter,uint64 validUntil,uint256 salt) terms)": {
        "$id": "update",
        "intent": "Change spending grant",
        "fields": [
          {
            "path": "grantId",
            "label": "Grant",
            "format": "raw"
          },
          {
            "path": "terms.delegate",
            "label": "Delegate",
            "format": "addressName",
            "params": {
              "types": [
                "eoa",
                "contract"
              ]
            }
          },
          {
            "path": "terms.recipientMode",
            "label": "Pays to",
            "format": "enum",
            "params": {
              "$ref": "$.metadata.enums.recipientMode"
            }
          },
          {
            "path": "terms.recipient",
            "label": "Recipient",
            "format": "addressName",
            "visible": {
              "ifNotIn": [
                "0x0000000000000000000000000000000000000000"
              ]
            }
          },
          {
            "path": "terms.windowSeconds",
            "label": "Rolling window",
            "format": "duration"
          },
          {
            "path": "terms.assets.[]",
            "fields": [
              {
                "path": "maxPerCall",
                "label": "Max per payment",
                "$ref": "$.display.definitions.cap"
              },
              {
                "path": "maxPerWindow",
                "label": "Max in any rolling window",
                "$ref": "$.display.definitions.cap"
              },
              {
                "path": "maxTotal",
                "label": "Max in total",
                "$ref": "$.display.definitions.cap"
              },
              {
                "$id": "Shown as each cap's token",
                "path": "asset",
                "visible": "never"
              }
            ]
          },
          {
            "path": "terms.validAfter",
            "label": "Valid from",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          },
          {
            "path": "terms.validUntil",
            "label": "Valid until",
            "format": "date",
            "params": {
              "encoding": "timestamp"
            }
          },
          {
            "$id": "Must be the sender; register and update revert otherwise",
            "path": "terms.principal",
            "visible": "never"
          },
          {
            "$id": "Only 0 (independent per-asset caps) is valid",
            "path": "terms.assetCombine",
            "visible": {
              "mustMatch": [
                0
              ]
            }
          },
          {
            "$id": "Distinguishes otherwise identical grants; update ignores it",
            "path": "terms.salt",
            "visible": "never"
          },
          {
            "path": "expectedVersion",
            "label": "From version",
            "format": "raw",
            "visible": "optional"
          }
        ]
      }
    }
  }
}
