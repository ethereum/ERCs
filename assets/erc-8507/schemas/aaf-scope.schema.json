{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aaf-scope.schema.json",
  "title": "Agent Allowlist Framework: scope document",
  "description": "Where a rule is meant to apply. Its keccak256 over the RFC 8785 form is Scope.documentHash",
  "type": "object",
  "required": ["aaf", "kind", "name", "activity", "actions", "boundary"],
  "additionalProperties": false,
  "properties": {
    "aaf": { "const": "1" },
    "kind": { "const": "scope" },
    "name": { "type": "string" },
    "activity": { "description": "The economy, event, task or resource the scope covers", "type": "string" },
    "actions": {
      "description": "The actions in scope. action = keccak256 of the name",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "meaning"],
        "additionalProperties": false,
        "properties": {
          "action": { "$ref": "aaf-defs.schema.json#/$defs/name" },
          "meaning": { "type": "string" }
        }
      }
    },
    "resources": { "type": "array", "items": { "type": "string" } },
    "boundary": { "description": "What is outside the scope", "type": "string" }
  }
}
