{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/garyyang-finchip/aid-standard/schemas/facets/tasks-erc8414-v1.schema.json",
  "title": "aid:tasks/erc8414/v1 — content document",
  "description": "Task-tender interaction record of the anchor, derived from ERC-8414 contract events by role. Open window = tenders not yet settled/cancelled; history window = settled records within `historyWindow` seconds.",
  "type": "object",
  "required": ["facetType", "subject", "observedAt", "historyWindow", "records"],
  "additionalProperties": false,
  "properties": {
    "facetType": { "const": "aid:tasks/erc8414/v1" },
    "subject": { "type": "string", "pattern": "^eip155:[0-9]+:0x[0-9a-fA-F]{40}$" },
    "observedAt": { "type": "integer" },
    "historyWindow": { "type": "integer", "description": "seconds; default 31536000 (365 days)" },
    "summary": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "created": { "type": "integer" }, "funded": { "type": "integer" }, "bid": { "type": "integer" },
        "fulfilled": { "type": "integer" }, "judged": { "type": "integer" },
        "fulfilledAccepted": { "type": "integer" }, "fulfilledRejected": { "type": "integer" },
        "acceptanceRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "medianTimeToFulfil": { "type": "integer", "description": "seconds" },
        "openTenders": { "type": "integer" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object", "required": ["chainId", "contract", "tokenId", "role", "at", "status"], "additionalProperties": true,
        "properties": {
          "chainId": { "type": "integer" },
          "contract": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "tokenId": { "type": "string", "description": "decimal string (uint256)" },
          "role": { "enum": ["creator", "funder", "bidder", "fulfiller", "judge"] },
          "at": { "type": "integer" },
          "txHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "taskHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
          "status": { "enum": ["open", "history"] },
          "outcome": { "enum": ["accepted", "rejected", "cancelled", "expired", "unjudged-paid", "pending"] },
          "bountyUsd": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
