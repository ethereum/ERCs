{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auf:v1:common.schema.json",
  "title": "AUF common definitions",
  "description": "Shared definitions for the AIFi Unit Framework data model (auf 1.0).",
  "$defs": {
    "aufVersion": { "type": "string", "const": "1.0" },
    "decimalString": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Economic quantities are decimal strings, never JSON numbers (Section 3.2)."
    },
    "unsignedDecimalString": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "share": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?|[0-9]+/[1-9][0-9]*)$",
      "description": "Decimal fraction or rational string in [0,1]."
    },
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "hexBytes": { "type": "string", "pattern": "^0x([0-9a-f]{2})*$" },
    "caip10": { "type": "string", "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}:[-.%a-zA-Z0-9]{1,128}$" },
    "caip19": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}(/[-.%a-zA-Z0-9]{1,78})?$"
    },
    "accountOrNone": { "oneOf": [{ "$ref": "#/$defs/caip10" }, { "const": "none" }] },
    "timestamp": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "integer", "minimum": 0 }
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^(auf|x):[A-Za-z0-9._-]+(:[A-Za-z0-9._-]+)*@[0-9]+$",
      "description": "Profile identifier <namespace>:<class>:<name>@<major> (Section 6.3)."
    },
    "extensionKey": { "type": "string", "pattern": "^x:[A-Za-z0-9._-]+(:[A-Za-z0-9._-]+)+(@[0-9]+)?$" },
    "extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/extensionKey" },
      "additionalProperties": {
        "type": "object",
        "properties": { "required": { "type": "boolean" } }
      }
    },
    "evidenceRef": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
    "subject": {
      "type": "object",
      "required": ["registry", "unitId", "version", "boundaryHash"],
      "properties": {
        "registry": { "$ref": "#/$defs/caip10" },
        "unitId": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "boundaryHash": { "$ref": "#/$defs/hex32" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["unit", "port", "element"] },
        "id": { "type": "string" }
      },
      "if": { "properties": { "type": { "enum": ["port", "element"] } } },
      "then": { "required": ["id"] },
      "additionalProperties": false
    },
    "denomination": {
      "type": "string",
      "description": "ISO 4217 currency code or CAIP-19 asset identifier.",
      "pattern": "^([A-Z]{3}|[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}(/[-.%a-zA-Z0-9]{1,78})?)$"
    }
  }
}
