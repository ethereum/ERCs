{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auf:v1:method-descriptor.schema.json",
  "title": "AUF method descriptor",
  "description": "Content-addressed descriptor of a valuation or analysis method (ERC Section 9). methodId = keccak256(JCS(document)).",
  "type": "object",
  "required": ["auf", "kind", "name", "version", "summary", "inputs", "outputs", "algorithm", "composability"],
  "properties": {
    "auf": { "$ref": "urn:auf:v1:common.schema.json#/$defs/aufVersion" },
    "kind": { "const": "method" },
    "name": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "summary": { "type": "string", "minLength": 1 },
    "inputs": { "type": "object", "description": "JSON Schema of the method inputs, or an object with a $ref to one." },
    "outputs": { "type": "object", "description": "JSON Schema of the method outputs, or an object with a $ref to one." },
    "algorithm": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "formula": { "type": "string" },
        "implementation": {
          "type": "object",
          "properties": { "uri": { "type": "string" }, "hash": { "type": "string" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "applicability": {
      "type": "object",
      "properties": {
        "roles": { "type": "array", "items": { "type": "string" } },
        "interests": { "type": "array", "items": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" } },
        "structures": { "type": "array", "items": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" } }
      },
      "additionalProperties": false
    },
    "composability": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["additive", "sub-additive", "super-additive", "conditional", "context-dependent", "unsupported", "unknown"]
        },
        "conditions": { "type": "string" }
      },
      "additionalProperties": false
    },
    "publisher": { "type": "string" },
    "extensions": { "$ref": "urn:auf:v1:common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}
