{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auf:v1:characterization.schema.json",
  "title": "AUF characterization content (auf:characterization:v1@1)",
  "description": "Stackable roles, behavior attributes, behavior models, structure, applications and knowledge state of a Unit version (ERC Section 7).",
  "type": "object",
  "required": ["auf", "kind", "subject"],
  "properties": {
    "auf": { "$ref": "urn:auf:v1:common.schema.json#/$defs/aufVersion" },
    "kind": { "const": "characterization" },
    "subject": { "$ref": "urn:auf:v1:common.schema.json#/$defs/subject" },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/roleStatement" } },
    "attributes": {
      "type": "object",
      "properties": {
        "linearity": { "enum": ["linear", "piecewise-linear", "nonlinear", "unknown"] },
        "determinism": { "enum": ["deterministic", "stochastic", "unknown"] },
        "timeVariance": { "enum": ["time-invariant", "time-varying", "unknown"] },
        "memory": { "enum": ["memoryless", "history-dependent", "unknown"] }
      },
      "additionalProperties": false
    },
    "models": { "type": "array", "items": { "$ref": "#/$defs/modelStatement" } },
    "structure": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile"],
        "properties": {
          "profile": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" },
          "parameters": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "knowledge": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["classified", "unclassified", "insufficient-evidence", "not-applicable"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": { "$ref": "urn:auf:v1:common.schema.json#/$defs/evidence" },
    "extensions": { "$ref": "urn:auf:v1:common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false,
  "$defs": {
    "role": {
      "oneOf": [
        { "enum": ["source", "sink", "conductor", "damping", "container", "pledge", "valve", "control"] },
        { "type": "string", "pattern": "^x:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+$" }
      ]
    },
    "roleStatement": {
      "type": "object",
      "required": ["role", "scope"],
      "properties": {
        "role": { "$ref": "#/$defs/role" },
        "scope": { "$ref": "urn:auf:v1:common.schema.json#/$defs/scope" },
        "mechanism": { "type": "string" },
        "state": { "type": "string" },
        "conditions": { "type": "string" },
        "window": { "type": "string" },
        "evidence": { "$ref": "urn:auf:v1:common.schema.json#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "modelStatement": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" },
        "modelRef": { "type": "string" },
        "parameters": { "type": "object" },
        "initialConditions": { "type": "object" },
        "applicability": {
          "type": "object",
          "properties": {
            "window": { "type": "string" },
            "scale": { "type": "string" },
            "operatingRange": { "type": "string" },
            "errorBound": { "type": "string" }
          }
        },
        "variables": { "type": "object" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/circuitElement" } },
        "premises": { "type": "object" },
        "equivalents": { "type": "array", "items": { "type": "object" } },
        "consistency": { "type": "object" },
        "evidence": { "$ref": "urn:auf:v1:common.schema.json#/$defs/evidence" }
      },
      "additionalProperties": false
    },
    "circuitElement": {
      "type": "object",
      "required": ["scope", "type"],
      "properties": {
        "scope": { "$ref": "urn:auf:v1:common.schema.json#/$defs/scope" },
        "type": {
          "enum": [
            "source", "resistive", "capacitive", "inductive", "memristive",
            "higher-order", "controlled", "switch", "stochastic"
          ]
        },
        "alpha": { "type": "integer" },
        "beta": { "type": "integer" },
        "parameters": { "type": "object" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
