{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auf:v1:profile-descriptor.schema.json",
  "title": "AUF profile descriptor",
  "description": "Descriptor of a named profile (role, structure, application, model, interest, port template or extension) (ERC Section 13.1). Its canonical hash may be registered with registerDescriptor under descriptorKind keccak256(\"auf:profile\").",
  "type": "object",
  "required": ["auf", "kind", "id", "version", "summary", "semantics"],
  "properties": {
    "auf": { "$ref": "urn:auf:v1:common.schema.json#/$defs/aufVersion" },
    "kind": { "const": "profile" },
    "id": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" },
    "class": { "enum": ["role", "structure", "application", "model", "characterization", "observation", "method", "interest", "port", "extension"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "summary": { "type": "string", "minLength": 1 },
    "semantics": { "type": "string", "minLength": 1 },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "schema": { "type": "object" },
    "publisher": { "type": "string" },
    "supersedes": { "$ref": "urn:auf:v1:common.schema.json#/$defs/identifier" },
    "extensions": { "$ref": "urn:auf:v1:common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}
