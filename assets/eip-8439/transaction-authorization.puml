@startuml
title 1. Transaction Authorization
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam nodesep 24
skinparam ranksep 28
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam maxMessageSize 0
skinparam sequence {
  ArrowColor #435B70
  LifeLineBorderColor #A3AFBC
  ParticipantBorderColor #64798B
  ParticipantBackgroundColor #FFFFFF
  GroupBorderColor #7D90A3
  GroupBackgroundColor #FAFCFE
}
skinparam note {
  BackgroundColor #FFFBEF
  BorderColor #CABD94
  FontSize 12
}
hide footbox
box "Off-chain | Business checks and authorization" #F0F5FA
actor "User / Merchant" as customer
participant "Acquirer" as acquirer
participant "Payment Network" as network
participant "Wallet" as wallet
endbox
box "On-chain | This ERC" #E5F3EB
participant "Ledger" as ledger
endbox
box "Off-chain | Funds processing" #FFF6E8
participant "Institution fiat systems" as funds
endbox
customer -> acquirer : 1 User initiates a payment or refund request
acquirer -> network : 2 Verify the merchant-side transaction\nSend the request and Acquirer signature
network -> wallet : 3 Forward the same request for Wallet verification and signature
wallet --> network : 4 Verify the user-side transaction and return the Wallet signature
network -> network : 5 Verify network rules and sign the same request\nCollect all three parties' signatures
@enduml
